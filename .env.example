# Copie estes nomes para as variáveis privadas do Render (não envie valores ao GitHub).
# Gere JWT_SECRET com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=7200000
DB_URL=jdbc:postgresql://host:5432/gabgym
DB_USERNAME=
DB_PASSWORD=
CORS_ORIGIN=http://localhost:3000
PORT=8080

# Habilite somente no PRIMEIRO deploy, remova depois de criar a conta.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
# TOTP superadmin: 20+ bytes aleatórios em base32, a configurar no autenticador.
# Gerar com: python -c "import secrets,base64; print(base64.b32encode(secrets.token_bytes(20)).decode().rstrip('='))"
ADMIN_TOTP_SECRET=
JPA_DDL_AUTO=update
